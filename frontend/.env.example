NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Cognito (Hosted UI + OAuth). Domain = host only (no https).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_DOMAIN=your-prefix.auth.eu-west-1.amazoncognito.com
# Optional; comma-separated if you need several URLs (must match Cognito app client exactly).
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/
